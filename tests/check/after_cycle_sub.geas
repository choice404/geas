// A cycle that closes through the members of a subcontract is still a cycle
record Item {
    sku: String
}

record Receipt {
    id: String
}

PayError is either Declined(reason: String) or Timeout or Gateway(code: Int)

contract Shop {
    subcontract Payment {
        pledge authorize() -> Unit after ship
        pledge capture() -> Unit after authorize
    }
    pledge ship() -> Unit after Payment
}
