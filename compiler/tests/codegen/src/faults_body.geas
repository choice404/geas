// Constructs the checker accepts and the module emitter names as build
// errors, each one a fault with its own span

record Pair {
    a: Int
    b: Int
}

internal contract Secret {
    pledge peek(x: Int) -> Result<Int, Int> {
        return Ok(x)
    }
}

contract Other {
    vow items: List<Int>

    pledge get(x: Int) -> Result<Int, Int> {
        return Ok(x)
    }
}

contract Faulty [version: "two"] {
    vow pair: Pair
    vow fine: Int = 1

    pledge hidden(x: Int) -> Result<Int, Int> {
        let s = Secret.sign()
        return s.peek(x)
    }
}
