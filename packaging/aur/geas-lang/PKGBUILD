# Maintainer: Austin Choi <austin.c.percussion@gmail.com>
pkgname=geas-lang
pkgver=1.0.1
pkgrel=1
pkgdesc="Language for durable obligations: contracts with deadlines, remedies, and signals, enforced by a C runtime any language can load"
arch=('x86_64')
url="https://github.com/choice404/geas"
license=('MIT')
# geas shells out to cc to compile the C it emits, so a C compiler is a
# runtime dependency, not just a build one, and the compiler itself links
# libstdc++. The runtime's SQLite is vendored and compiled in, so the store
# adds nothing here.
depends=('gcc' 'glibc' 'libstdc++')
# The compiler is C++23 built by CMake; the g++ it needs comes with gcc above,
# which has to be 13 or newer for std::expected.
makedepends=('cmake')
provides=('geas')
conflicts=('geas' 'geas-lang-git' 'geas-lang-bin')
# The package was named geas through 1.0.0
replaces=('geas')
source=("geas-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "geas-$pkgver"
  make compiler runtime
}

check() {
  cd "geas-$pkgver"
  # The binary must agree with the package about what version it is
  test "$(target/bin/geas version)" = "geas $pkgver"
  # The front end and codegen goldens, the smoke walk, and two runtime gates,
  # under a minute
  make quick
}

package() {
  cd "geas-$pkgver"
  make DESTDIR="$pkgdir" PREFIX=/usr install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 spec.md "$pkgdir/usr/share/doc/$pkgname/spec.md"
}
