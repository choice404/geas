contract Flow {
    pledge value(n: Int) -> Option<Int>
    clause number() -> Int { return 1 }
    course {
        let mut count = 0
        together {
            let literal = 1
            number()
            count = 2
            if true { value(0) }
            while false { value(0) }
            for item in [1] { value(item) }
            sleep 1s
            together { value(0) }
            return
        }
    }
}
