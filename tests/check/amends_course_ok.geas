// The course against version 1: an unchanged course carries its frame with
// no item, a changed course and a course this version adds restart, and a
// course this version drops needs no item. A course whose text stays while
// a record one of its slots holds changes, and one that changes only in a
// literal, are changed courses and restart; a course that changes only in
// its comments and spacing is the same course and carries
contract AmendCourseSame [version: 2] {
    pledge step(n: Int) -> Result<Int, String>
    course {
        let a = step(1)?
        step(a)?
    }
    amends 1 {
    }
}

contract AmendCourseChanged [version: 2] {
    pledge step(n: Int) -> Result<Int, String>
    course {
        let a = step(1)?
        step(a + 1)?
    }
    amends 1 {
        restart course
    }
}

contract AmendCourseAdded [version: 2] {
    pledge step(n: Int) -> Result<Int, String>
    course {
        step(1)?
    }
    amends 1 {
        restart course
    }
}

contract AmendCourseDropped [version: 2] {
    pledge step(n: Int) -> Result<Int, String>
    amends 1 {
    }
}

contract AmendCourseNone [version: 2] {
    pledge step(n: Int) -> Result<Int, String>
    amends 1 {
    }
}

record Tally {
    count: Int
    extra: Int
}

contract AmendCourseRetyped [version: 2] {
    pledge step(n: Int) -> Result<Int, String>
    clause tally() -> Tally {
        return Tally { count: 1, extra: 2 }
    }
    course {
        let total = tally()
        step(total.count)?
    }
    amends 1 {
        restart course
    }
}

contract AmendCourseLiteral [version: 2] {
    pledge step(n: Int) -> Result<Int, String>
    course {
        step(2)?
    }
    amends 1 {
        restart course
    }
}

contract AmendCourseComment [version: 2] {
    pledge step(n: Int) -> Result<Int, String>
    course {
        // The one step, spelled the way version 1 spelled it
        step( 1 )?
    }
    amends 1 {
    }
}
