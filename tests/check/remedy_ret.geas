// A remedy answers Result<Unit, E> or Unit
record Item {
    sku: String
}

record Receipt {
    id: String
}

PayError is either Declined(reason: String) or Timeout or Gateway(code: Int)

contract Shop {
    pledge pay() -> Result<Receipt, PayError>
    pledge ship() -> Result<Item, PayError>
    remedy refund for pay(receipt: Receipt) -> Result<Receipt, PayError>
    remedy recall for ship(item: Item) -> Option<Int>
}
