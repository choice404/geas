// Version 1 of the HostLedger contract compiler/tests/codegen/amends/src/amend_host.geas
// amends from
contract HostLedger {
    vow account: String
    vow limit: Int = 100
    vow note: String

    subcontract Billing {
        pledge charge(amount: Int) -> Result<Int, String>
    }
    subcontract {
        pledge log() -> Unit
    }
    pledge reserve() -> Result<Int, String>
    pledge legacy() -> Unit
    signal approved(by: String)

    remedy refund for charge(id: Int) -> Unit
    remedy release for reserve(id: Int) -> Unit
}
