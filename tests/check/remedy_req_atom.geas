// A remedy is never a requirements atom
record Item {
    sku: String
}

record Receipt {
    id: String
}

PayError is either Declined(reason: String) or Timeout or Gateway(code: Int)

contract Shop {
    pledge pay() -> Result<Receipt, PayError>
    remedy refund for pay(receipt: Receipt) -> Unit
    requirements {
        fulfill: pay && refund
    }
}
