// Version 1 of the contract the subcontract case of tests/check amends
// from: Payment holds charge alone, is not transactional, and the contract
// writes no requirements block
contract AmendSubParts {
    vow dsn: String = "file:parts.db"

    schema Ledger {
        id: Int
        amount: Int
    }

    subcontract Payment {
        pledge charge(amount: Int) -> Result<Unit, Int>
    }
    pledge settle() -> Result<Unit, Int>
    pledge ship() -> Result<Unit, Int>
}
