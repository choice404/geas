// A term appears at most once on a declaration
record Item {
    sku: String
}

record Receipt {
    id: String
}

PayError is either Declined(reason: String) or Timeout or Gateway(code: Int)

contract Shop {
    pledge pay() -> Unit
        within 30s
        within 1m
    subcontract Tail after pay after pay {
        pledge ship() -> Unit
    }
}
