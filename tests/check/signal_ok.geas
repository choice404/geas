// Signals: declared loose and inside a subcontract, named by an after term and
// by requirements, and delivered through a signed instance as a Unit call
record Item {
    sku: String
}

record Receipt {
    id: String
}

PayError is either Declined(reason: String) or Timeout or Gateway(code: Int)

contract Shop {
    pledge ship() -> Unit
    signal delivered(sku: String, count: Int) after ship within 14d
    signal cancelled()
    subcontract Feedback {
        signal rated(stars: Int)
        pledge thank() -> Unit after rated
    }
    requirements {
        fulfill: ship && delivered
        break: cancelled && !delivered
    }
}

contract Host {
    pledge run() -> Unit {
        let shop = Shop.sign()
        shop.ship()
        shop.delivered("sku", 2)
        shop.rated(5)
        let nothing: Unit = shop.cancelled()
    }
}
