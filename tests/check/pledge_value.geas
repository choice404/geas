// Pledge values are not part of this version of the language: the pledge
// type is refused in a clause parameter and a let annotation, where no value
// crosses the boundary, and a pledge named on an instance without a call is
// refused as the value it would be. The syntax still parses, so the spelling
// stays reserved

contract Vault {
    pledge ping() -> Result<Int, Int> {
        return Ok(7)
    }
}

contract Gate {
    pledge open() -> Result<Int, Int> {
        let v: Vault = Vault.sign()
        let step: pledge() -> Result<Int, Int> = v.ping
        return Ok(probe(step))
    }

    clause probe(step: pledge() -> Result<Int, Int>) -> Int {
        return 2
    }
}
