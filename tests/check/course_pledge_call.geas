// Only a course calls a pledge by bare name, and with its own signature
record Item {
    sku: String
}

record Receipt {
    id: String
}

PayError is either Declined(reason: String) or Timeout or Gateway(code: Int)

contract Flow {
    pledge step(n: Int) -> Result<Int, PayError>
    pledge other() -> Unit {
        step(1)
    }
    course {
        step()
        step("one")
        let held = step
        let n: String = step(2)?
        let q = 5?
    }
}
