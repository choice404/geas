import std.process

contract Steps {
    pledge run(command: Command) -> Result<Unit, ExitError> {
        return execute(command)
    }

    clause execute(command: Command) -> Result<Unit, ExitError> {
        return Process.run(command)
    }

    pledge copy(target: String) -> Result<Unit, ExitError> {
        return Process.run(Command {
            program: "/bin/cp", args: [target, target + ".copy"],
            stdout_path: "", stderr_path: ""
        })
    }
}

contract ProgramRemedy {
    vow output_path: String

    pledge prepare() -> Result<Unit, ExitError> {
        return Process.run(Command {
            program: "/bin/true", args: [], stdout_path: "", stderr_path: ""
        })
    }

    pledge fail() -> Result<Unit, ExitError> after prepare {
        return Process.run(Command {
            program: "/bin/false", args: [], stdout_path: "", stderr_path: ""
        })
    }

    remedy undo for prepare() -> Result<Unit, ExitError> {
        return Process.run(Command {
            program: "/bin/echo", args: ["undone"], stdout_path: output_path, stderr_path: ""
        })
    }

    requirements {
        fulfill: prepare && fail
        partial: prepare
        break: !fail
    }
}
