import jobattrs

CopyError is either CopyFailed

contract Job [queue: "batch", priority: -2, weight: -1.5, enabled: true, delay: -250ms] {
    clause complete() -> Unit { return }
    pledge copy(target: String) -> Result<Unit, CopyError> [program: "/bin/copy", region: 64M, region_max: 512M, threads: 1] {
        return Ok(complete())
    }
    subcontract Finish [pool: "local"] {
        pledge flush() -> Unit { return }
        signal ready() [channel: "job.ready"]
    }
    remedy undo for copy() -> Unit [program: "/bin/remove"] { return }
}
