shape contract OrderCourse;vow card:S;vow cents:I;vow sku:S;vow hold:D;vow grace:D;pledge authorize:(NCard)->R(NAuthId,NPayError);pledge capture:(NAuthId)->R(NReceipt,NPayError);pledge plan:(D)->R(D,NStockError);pledge reserve:(S,D)->R(NReservation,NStockError);pledge dispatch:(NReservation)->R(NTracking,NShipError);pledge notify:(NTracking)->R(V,NShipError);signal delivered:(NTracking)->V;remedy refund:capture:(NReceipt)->R(V,NPayError);remedy release:reserve:(NReservation)->R(V,NStockError);remedy recall:dispatch:(NTracking)->R(V,NShipError);terms pledge authorize:within=30000,retry=3/every=2000/backoff=2/cap=30000/on=Timeout+Gateway;terms pledge capture:after=authorize,within=60000;terms pledge dispatch:after=Payment+reserve;terms pledge notify:after=dispatch;terms signal delivered:after=dispatch,within=259200000;terms remedy refund:retry=2/every=60000;course;term 604800000;type AuthId{token:S};type Card{number:S};type PayError=Declined(reason:S)|Timeout|Gateway(code:I);type Receipt{id:S,amount:I};type Reservation{id:S,sku:S,hold:D};type ShipError=NoCarrier|Refused(reason:S);type StockError=OutOfStock(sku:S)|Unavailable;type Tracking{carrier:S,code:S};
vow card S
vow cents I
vow sku S
vow hold D
vow grace D
pledge authorize (NCard)->R(NAuthId,NPayError) NAuthId
pledge capture (NAuthId)->R(NReceipt,NPayError) NReceipt
