// A pledge read off an instance without a call would be a first class
// pledge value, which this version of the language leaves out, so the build
// stops at the checker before any C is emitted.

contract Helper {
    pledge ping() -> Result<Int, Int> {
        return Ok(1)
    }
}

contract Main {
    pledge run(args: List<String>) -> Result<Int, Int> {
        let h = Helper.sign()
        let p = h.ping
        h.break()
        return Ok(0)
    }
}
