// A record literal builds its fields in declaration order whatever order
// the source lists them in, and a variant's payload labels only repeat its
// field names, so neither the order nor the labels change the hash
record R {
    a: Int
    b: Int
}
Shape is either Box(width: Int, height: Int) or Dot
contract Flow {
    pledge keep(r: R, s: Shape) -> Option<Int>
    course {
        let r = R { b: 2, a: 1 }
        let s = Box(3, 4)
        keep(r, s)?
    }
}
