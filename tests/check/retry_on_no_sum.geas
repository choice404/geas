// Without a declared sum on the Err side an on list has nothing to name
record Item {
    sku: String
}

record Receipt {
    id: String
}

PayError is either Declined(reason: String) or Timeout or Gateway(code: Int)

contract Shop {
    pledge pay() -> Result<Receipt, String>
        retry 3 on Timeout
    pledge ship() -> Option<Int>
        retry 3 on Timeout
    pledge bill() -> Result<Receipt, PayError>
    remedy refund for bill(receipt: Receipt) -> Unit
        retry 2 on Timeout
}
