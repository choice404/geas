// A member never waits on the subcontract it sits in, nor a subcontract on its own member
record Item {
    sku: String
}

record Receipt {
    id: String
}

PayError is either Declined(reason: String) or Timeout or Gateway(code: Int)

contract Shop {
    subcontract Payment {
        pledge authorize() -> Unit after Payment
        signal settled() after Payment
    }
    subcontract Shipping after pack {
        pledge pack() -> Unit
    }
}
